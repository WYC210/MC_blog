{
  "name": "homecraft",
  "version": "0.1.0",
  "private": true,
  "description": "Build your own Minecraft-inspired 3D personal website.",
  "keywords": ["personal-website", "homepage", "portfolio", "template", "threejs", "voxel", "webring", "vibe-coding"],
  "homepage": "https://github.com/terryHu7/homecraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terryHu7/homecraft.git"
  },
  "bugs": {
    "url": "https://github.com/terryHu7/homecraft/issues"
  },
  "author": "Terry (https://terryhu.cn)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "python3 tools/serve.py",
    "check:site": "node tools/check-site.mjs",
    "check": "node tools/check-site.mjs && node tools/check.mjs",
    "check:portal": "node --test tools/check-directory.test.mjs && node tools/sync-protocol.mjs --check && node tools/check-portal.mjs",
    "check:input": "node tools/check-input.mjs",
    "check:metadata": "node tools/check-metadata.mjs",
    "check:piano": "node tools/check-piano-ui.mjs",
    "check:computer": "node tools/check-computer.mjs",
    "check:beach": "node tools/check-beach.mjs",
    "check:furniture": "node tools/check-furniture.mjs",
    "check:fountain": "node tools/check-fountain.mjs",
    "check:night-lighting": "node tools/check-night-lighting.mjs",
    "check:night-sky": "node tools/check-night-sky.mjs",
    "check:lookout": "node tools/check-lookout.mjs",
    "check:night-concert": "node tools/check-night-concert.mjs",
    "check:night-nature": "node tools/check-night-nature.mjs",
    "check:jet-ski": "node tools/check-jet-ski.mjs",
    "check:qin-island": "node tools/check-qin-island.mjs",
    "check:qin-guides": "node tools/check-qin-guides.mjs",
    "check:qin-flags": "node tools/check-qin-flags.mjs",
    "check:qin-academy": "node tools/check-qin-academy.mjs",
    "check:qin-warriors": "node tools/check-qin-warriors.mjs",
    "check:qin-bianque": "node tools/check-qin-bianque.mjs",
    "check:qin-hanfei": "node tools/check-qin-hanfei.mjs",
    "check:qin-gateway": "node tools/check-qin-gateway.mjs",
    "check:qin-emperor": "node tools/check-qin-emperor.mjs",
    "check:qin-encounter": "node tools/check-qin-encounter.mjs",
    "check:qin-east-statues": "node tools/check-qin-east-statues.mjs",
    "check:qin-garden-landmarks": "node tools/check-qin-garden-landmarks.mjs",
    "check:qin-dock": "node tools/check-qin-dock.mjs",
    "check:qin-coastal-landmarks": "node tools/check-qin-coastal-landmarks.mjs",
    "check:qin-palace-media": "node tools/check-qin-palace-media.mjs",
    "check:qin-palace-structure": "node tools/check-qin-palace-structure.mjs",
    "check:qin-great-wall": "node tools/check-qin-great-wall.mjs",
    "check:qin-cinema": "node tools/check-qin-cinema.mjs",
    "check:lehun": "node tools/check-lehun.mjs",
    "check:minimap": "node tools/check-minimap.mjs",
    "check:map-icons": "node tools/check-map-icons.mjs",
    "check:travel": "node tools/check-travel-agency.mjs",
    "check:mailbox": "node --experimental-vm-modules tools/check-mailbox.cjs && node tools/check-mailbox-ui.cjs",
    "build": "bash tools/build.sh",
    "directory": "node tools/directory.mjs check"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
